+// SR2: look a type up among the imports from other modules
+asCTypeInfo *asCModule::GetImportedType(const asCString &type, asSNameSpace *ns) const
+{
+	asUINT n;
+	for( n = 0; n < importedClassTypes.GetLength(); n++ )
+		if( importedClassTypes[n]->name == type && importedClassTypes[n]->nameSpace == ns )
+			return importedClassTypes[n];
+
+	for( n = 0; n < importedEnumTypes.GetLength(); n++ )
+		if( importedEnumTypes[n]->name == type && importedEnumTypes[n]->nameSpace == ns )
+			return importedEnumTypes[n];
+
+	for( n = 0; n < importedTypeDefs.GetLength(); n++ )
+		if( importedTypeDefs[n]->name == type && importedTypeDefs[n]->nameSpace == ns )
+			return importedTypeDefs[n];
+
+	for( n = 0; n < importedFuncDefs.GetLength(); n++ )
+		if( importedFuncDefs[n]->name == type && importedFuncDefs[n]->nameSpace == ns )
+			return importedFuncDefs[n];
+
 	return 0;
+}
+
+// SR2 interface
+void asCModule::ImportType(asITypeInfo *ti)
+{
+	asCTypeInfo *type = reinterpret_cast<asCTypeInfo*>(ti);
+	if( type == 0 )
+		return;
+
+	if( type->flags & asOBJ_FUNCDEF )
+	{
+		asCFuncdefType *defType = CastToFuncdefType(type);
+		if( defType && importedFuncDefs.IndexOf(defType) == -1 )
+		{
+			defType->AddRef();
+			importedFuncDefs.PushLast(defType);
+		}
+	}
+	else if( type->flags & asOBJ_ENUM )
+	{
+		asCEnumType *enumType = CastToEnumType(type);
+		if( enumType && importedEnumTypes.IndexOf(enumType) == -1 )
+		{
+			enumType->AddRef();
+			importedEnumTypes.PushLast(enumType);
+		}
+	}
+	else if( type->flags & asOBJ_TYPEDEF )
+	{
+		asCTypedefType *defType = CastToTypedefType(type);
+		if( defType && importedTypeDefs.IndexOf(defType) == -1 )
+		{
+			defType->AddRef();
+			importedTypeDefs.PushLast(defType);
+		}
+	}
+	else if( type->flags & (asOBJ_VALUE | asOBJ_REF | asOBJ_LIST_PATTERN) )
+	{
+		asCObjectType *objType = CastToObjectType(type);
+		if( objType && importedClassTypes.IndexOf(objType) == -1 )
+		{
+			objType->AddRef();
+			importedClassTypes.PushLast(objType);
+		}
+	}
+}
+
+// SR2 interface
+void asCModule::ImportGlobalFunction(asIScriptFunction *function)
+{
+	asCScriptFunction *f = static_cast<asCScriptFunction*>(function);
+	if( f == 0 || f->objectType )
+		return;
+
+	// Already imported along another path
+	if( importedGlobalFunctions.GetIndex(f) != -1 )
+		return;
+
+	f->AddRef();
+	importedGlobalFunctions.Put(f);
+}
+
+// SR2 interface
+void asCModule::ImportGlobalVariable(asIScriptModule *module, asUINT index)
+{
+	asCGlobalProperty *prop = 0;
+	asCModule *other = static_cast<asCModule*>(module);
+	if( other == 0 )
+		return;
+
+	if( index < other->m_scriptGlobals.GetSize() )
+	{
+		prop = other->m_scriptGlobals.Get(index);
+	}
+	else
+	{
+		index -= other->m_scriptGlobals.GetSize();
+		if( index < other->importedGlobals.GetSize() )
+			prop = other->importedGlobals.Get(index);
+	}
+
+	if( prop )
+	{
+		if( importedGlobals.GetIndex(prop) != -1 )
+			return;
+
+		prop->AddRef();
+		importedGlobals.Put(prop);
+	}
+}
+
+// SR2 interface
+void asCModule::ClearImports()
+{
+	asUINT n;
+	for( n = 0; n < importedClassTypes.GetLength(); n++ )
+		importedClassTypes[n]->Release();
+	importedClassTypes.SetLength(0);
+
+	for( n = 0; n < importedEnumTypes.GetLength(); n++ )
+		importedEnumTypes[n]->Release();
+	importedEnumTypes.SetLength(0);
+
+	for( n = 0; n < importedTypeDefs.GetLength(); n++ )
+		importedTypeDefs[n]->Release();
+	importedTypeDefs.SetLength(0);
+
+	for( n = 0; n < importedFuncDefs.GetLength(); n++ )
+		importedFuncDefs[n]->Release();
+	importedFuncDefs.SetLength(0);
+
+	for( n = 0; n < importedGlobalFunctions.GetSize(); n++ )
+		importedGlobalFunctions.Get(n)->Release();
+	importedGlobalFunctions.Clear();
+
+	for( n = 0; n < importedGlobals.GetSize(); n++ )
+		importedGlobals.Get(n)->Release();
+	importedGlobals.Clear();
 }
 
